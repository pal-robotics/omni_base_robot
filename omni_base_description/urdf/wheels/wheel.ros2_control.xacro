<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- TODO Compute real wheel max velocity -->

  <!-- MACRO DEFINITION -->
  <xacro:macro name="ros2_control_wheel" params="side sim_type:=^|gazebo">
    <joint name="wheel_${side}_joint">
      <command_interface name="velocity"/>
      <state_interface name="position" />
    </joint>

    <transmission name="wheel_${side}_trans">
      <plugin>transmission_interface/SimpleTransmission</plugin>
      <xacro:if value="${sim_type == 'mujoco-ros2-control'}">
        <actuator name="wheel_${side}_joint" role="actuator1"/>
      </xacro:if>
      <xacro:unless value="${sim_type == 'mujoco-ros2-control'}">
        <actuator name="wheel_${side}_actuator" role="actuator1"/>
      </xacro:unless>
      <joint name="wheel_${side}_joint" role="joint1">
        <mechanical_reduction>1.0</mechanical_reduction>
      </joint>
    </transmission>
  </xacro:macro>
</robot>
